{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "..",
    "outDir": "../.eval-build",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "incremental": false,
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["runner.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules", "../app", "../.next"]
}
